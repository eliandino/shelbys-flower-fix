# Copy this file to .env and fill in real values. .env itself is
# gitignored and should never be committed.

# SQLite for local dev. When this moves to production, swap for a
# Postgres connection string (e.g. from Neon or Supabase) instead.
DATABASE_URL="file:./dev.db"

PORT=3001

# Comma-separated list of origins allowed to call this API from a browser.
FRONTEND_ORIGIN="http://localhost:5500,http://127.0.0.1:5500"
