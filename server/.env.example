# Copy this file to .env and fill in real values. .env itself is
# gitignored and should never be committed.

# Postgres connection string. Use a separate Neon branch (or database)
# for local dev so testing never touches real customer orders.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

PORT=3001

# Comma-separated list of the site's base URLs. These are allowed to call
# this API from a browser, and the first one is used to build the payment
# links sent to customers. A URL may include a path, e.g.
# https://eliandino.github.io/shelbys-flower-fix
FRONTEND_ORIGIN="http://localhost:5500,http://127.0.0.1:5500"

# Shelby's password for the admin dashboard.
ADMIN_PASSWORD="change-me"

# Long random string used to sign admin logins. Changing it logs everyone
# out. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET="change-me-too"
